DATABASE_URL="postgresql://ats:ats@localhost:5432/ats?schema=public"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Optional: enables automatic resume parsing (summary/skills/achievements)
# on the public candidate profile form. Leave unset to skip parsing —
# profile creation still works, those fields just stay empty.
ANTHROPIC_API_KEY=""
