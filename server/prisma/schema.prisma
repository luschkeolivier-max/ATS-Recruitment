generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECRUITER
  INTERVIEWER
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum Stage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(RECRUITER)
  createdAt    DateTime @default(now())

  jobsCreated       Job[]         @relation("JobCreatedBy")
  notes             Note[]        @relation("NoteAuthor")
  interviewsGiven   Interview[]   @relation("InterviewInterviewer")
  stageChanges      StageHistory[] @relation("StageChangedBy")
}

model Job {
  id          String    @id @default(uuid())
  title       String
  department  String?
  location    String?
  description String?
  status      JobStatus @default(OPEN)
  createdBy   User      @relation("JobCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  applications Application[]
}

model Candidate {
  id            String    @id @default(uuid())
  name          String
  email         String
  phone         String?
  linkedinUrl   String?
  whatsapp      String?
  resumeUrl     String?
  videoIntroUrl String?
  source        String?
  tags          String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Auto-extracted from the uploaded resume via the Claude API — see
  // src/services/resumeParser.js. Null until parsed (or if parsing is
  // unavailable / fails).
  resumeSummary      String?
  resumeSkills       String[] @default([])
  resumeAchievements String[] @default([])
  resumeParsedAt     DateTime?

  applications Application[]

  @@unique([email])
}

model Application {
  id          String   @id @default(uuid())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId       String
  stage       Stage    @default(APPLIED)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notes         Note[]
  interviews    Interview[]
  stageHistory  StageHistory[]

  @@unique([candidateId, jobId])
}

model StageHistory {
  id            String      @id @default(uuid())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  fromStage     Stage?
  toStage       Stage
  changedBy     User        @relation("StageChangedBy", fields: [changedById], references: [id])
  changedById   String
  createdAt     DateTime    @default(now())
}

model Interview {
  id            String          @id @default(uuid())
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  interviewer   User            @relation("InterviewInterviewer", fields: [interviewerId], references: [id])
  interviewerId String
  scheduledAt   DateTime
  durationMins  Int             @default(30)
  location      String?
  status        InterviewStatus @default(SCHEDULED)
  feedback      String?
  rating        Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Note {
  id            String      @id @default(uuid())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  author        User        @relation("NoteAuthor", fields: [authorId], references: [id])
  authorId      String
  content       String
  createdAt     DateTime    @default(now())
}
